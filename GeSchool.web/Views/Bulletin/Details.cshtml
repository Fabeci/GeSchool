@model BulletinDto

@{
    ViewData["Title"] = "Bulletin";
    ViewData["Subtitle"] = Model.NomComplet;
    if (User.IsInRole("Administrateur"))
    {
        ViewData["BreadcrumbParent"] = ("Bulletins", Url.Action("Index", "Bulletin") ?? "/Bulletin");
    }

    string SexeLabel(Sexe? sexe) => sexe switch
    {
        Sexe.Masculin => "Masculin",
        Sexe.Feminin => "Féminin",
        _ => "—"
    };
}

<div style="display:flex;justify-content:flex-end;margin-bottom:var(--space-3);" data-no-print>
    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
        @IconHelper.Render("printer")
        Imprimer
    </button>
</div>

<div class="card" style="margin-bottom:var(--space-5);">
    <div class="card-body" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:var(--space-5);">
        <dl style="margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:var(--space-4);flex:1;min-width:280px;">
            <div>
                <dt style="font-size:.75rem;color:var(--text-secondary);text-transform:uppercase;">Nom</dt>
                <dd style="margin:0;font-weight:600;">@Model.Nom</dd>
            </div>
            <div>
                <dt style="font-size:.75rem;color:var(--text-secondary);text-transform:uppercase;">Prénom</dt>
                <dd style="margin:0;font-weight:600;">@Model.Prenom</dd>
            </div>
            <div>
                <dt style="font-size:.75rem;color:var(--text-secondary);text-transform:uppercase;">Sexe</dt>
                <dd style="margin:0;">@SexeLabel(Model.Sexe)</dd>
            </div>
            <div>
                <dt style="font-size:.75rem;color:var(--text-secondary);text-transform:uppercase;">N° Étudiant</dt>
                <dd style="margin:0;">@Model.NumeroEtudiant</dd>
            </div>
            <div>
                <dt style="font-size:.75rem;color:var(--text-secondary);text-transform:uppercase;">Date de naissance</dt>
                <dd style="margin:0;">@Model.DateNaissance.ToString("yyyy-MM-dd")</dd>
            </div>
            <div>
                <dt style="font-size:.75rem;color:var(--text-secondary);text-transform:uppercase;">Département</dt>
                <dd style="margin:0;">@Model.Departement</dd>
            </div>
            <div>
                <dt style="font-size:.75rem;color:var(--text-secondary);text-transform:uppercase;">Email</dt>
                <dd style="margin:0;">@Model.Email</dd>
            </div>
        </dl>
        <div style="text-align:right;">
            <div style="font-size:.8125rem;color:var(--text-secondary);">Moyenne générale</div>
            <div style="font-size:1.5rem;font-weight:700;color:var(--primary);">@Model.MoyenneGenerale.ToString("0.00") / 20</div>
        </div>
    </div>
</div>

@if (Model.Cours.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "book-open", Title = "Aucun cours", Message = "Cet étudiant n'est inscrit à aucun cours pour le moment." })" />
}
else
{
    <div style="display:flex;flex-direction:column;gap:var(--space-4);">
        @foreach (var cours in Model.Cours)
        {
            <div class="card">
                <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
                    <span>@cours.Code - @cours.Intitule <span class="badge-soft neutral">@cours.Credits crédits</span></span>
                    @if (cours.MoyenneCours.HasValue)
                    {
                        <span class="badge-soft @(cours.MoyenneCours.Value >= 10 ? "success" : "danger")">Moyenne : @cours.MoyenneCours.Value.ToString("0.00") / 20</span>
                    }
                    else
                    {
                        <span class="badge-soft neutral">Aucune note</span>
                    }
                </div>
                <div class="card-body">
                    @if (cours.Notes.Count == 0)
                    {
                        <p class="mb-0" style="color:var(--text-secondary);font-size:.875rem;">Aucune note enregistrée pour ce cours.</p>
                    }
                    else
                    {
                        <table class="gs-table" style="border:none;">
                            <thead>
                                <tr>
                                    <th>Type d'évaluation</th>
                                    <th>Valeur</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var note in cours.Notes)
                                {
                                    <tr>
                                        <td>@note.TypeEvaluation</td>
                                        <td>
                                            <span class="badge-soft @(note.Valeur >= 10 ? "success" : "danger")">@note.Valeur / 20</span>
                                        </td>
                                        <td>@note.DateEvaluation.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    </div>
}
