@model UpdateCoursDto

@{
    ViewData["Title"] = "Modifier le cours";
}

<div class="card" style="max-width:640px;">
    <div class="card-body">
        <form asp-controller="Cours" asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:var(--space-4);"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Intitule" class="form-label"></label>
                <input asp-for="Intitule" class="form-control" />
                <span asp-validation-for="Intitule" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Credits" class="form-label"></label>
                <input asp-for="Credits" class="form-control" />
                <span asp-validation-for="Credits" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Semestre" class="form-label"></label>
                <input asp-for="Semestre" class="form-control" />
                <span asp-validation-for="Semestre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DepartementId" class="form-label"></label>
                <select asp-for="DepartementId" class="form-select" asp-items="@(ViewBag.Departements as SelectList)">
                    <option value="">-- Choisir un département --</option>
                </select>
                <span asp-validation-for="DepartementId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnseignantId" class="form-label"></label>
                <select asp-for="EnseignantId" class="form-select" asp-items="@(ViewBag.Enseignants as SelectList)">
                    <option value="">-- Choisir un enseignant --</option>
                </select>
                <span asp-validation-for="EnseignantId" class="text-danger"></span>
            </div>
            <div style="display:flex;gap:var(--space-2);margin-top:var(--space-5);">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a asp-action="Index" class="btn btn-link">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
