@model IReadOnlyList<DepartementDto>

@{
    ViewData["Title"] = "Départements";
    ViewData["Subtitle"] = "Gérer les départements de l'établissement";
}

<div class="gs-page-header">
    <div class="gs-search">
        @IconHelper.Render("search")
        <input type="search" class="form-control" placeholder="Rechercher un département..." data-table-search data-table-target="#departementsTable" aria-label="Rechercher un département" />
    </div>
    <a asp-action="Create" class="btn btn-primary">
        @IconHelper.Render("plus")
        Nouveau département
    </a>
</div>

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "building", Title = "Aucun département", Message = "Aucun département n'a encore été créé.", ActionText = "Créer un département", ActionController = "Departements" })" />
}
else
{
    <div class="gs-table-wrapper gs-table-responsive">
        <table class="gs-table" id="departementsTable">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th class="col-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr data-row>
                        <td>@item.Nom</td>
                        <td>@item.Description</td>
                        <td class="col-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="Détails" aria-label="Détails du département @item.Nom">@IconHelper.Render("eye")</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon" title="Modifier" aria-label="Modifier @item.Nom">@IconHelper.Render("pencil")</a>
                            <button type="button" class="btn-icon" title="Supprimer" aria-label="Supprimer @item.Nom" data-bs-toggle="modal" data-bs-target="#confirmDeleteDepartement" data-id="@item.Id" data-label="@item.Nom">
                                @IconHelper.Render("trash")
                            </button>
                        </td>
                    </tr>
                }
                <tr data-search-empty style="display:none;">
                    <td colspan="3" style="text-align:center;color:var(--text-secondary);padding:var(--space-5);">Aucun résultat pour cette recherche.</td>
                </tr>
            </tbody>
        </table>
    </div>
}

<partial name="_ConfirmDeleteModal" model="@(new ConfirmDeleteModalViewModel { Id = "confirmDeleteDepartement", Title = "Supprimer ce département ?", Message = "Cette action est irréversible.", Controller = "Departements" })" />
