@model EnseignantDto

@{
    ViewData["Title"] = "Détails de l'enseignant";
}

<div class="card" style="max-width:560px;">
    <div class="card-header">@Model.Nom @Model.Prenom</div>
    <div class="card-body">
        <dl style="margin:0;display:grid;gap:var(--space-4);">
            <div>
                <dt style="font-size:.75rem;color:var(--text-secondary);text-transform:uppercase;">Email</dt>
                <dd style="margin:0;">@Model.Email</dd>
            </div>
            <div>
                <dt style="font-size:.75rem;color:var(--text-secondary);text-transform:uppercase;">Spécialité</dt>
                <dd style="margin:0;">@(string.IsNullOrWhiteSpace(Model.Specialite) ? "—" : Model.Specialite)</dd>
            </div>
        </dl>
    </div>
</div>

<div style="margin-top:var(--space-4);display:flex;gap:var(--space-2);">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        @IconHelper.Render("pencil")
        Modifier
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">Retour à la liste</a>
</div>
