@model PagedList<EnseignantDto>

@{
    ViewData["Title"] = "Enseignants";
    ViewData["Subtitle"] = "Gérer le corps enseignant";
}

<div class="gs-page-header">
    <div class="gs-search">
        @IconHelper.Render("search")
        <input type="search" class="form-control" placeholder="Rechercher un enseignant..." data-table-search data-table-target="#enseignantsTable" aria-label="Rechercher un enseignant" />
    </div>
    <button type="button" class="btn btn-outline-secondary" data-csv-export data-csv-target="#enseignantsTable" data-csv-filename="enseignants.csv">
        @IconHelper.Render("download")
        Exporter CSV
    </button>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createEnseignantModal">
        @IconHelper.Render("plus")
        Nouvel enseignant
    </button>
</div>

@if (Model.TotalCount == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "users", Title = "Aucun enseignant", Message = "Aucun enseignant n'a encore été créé.", ActionText = "Créer un enseignant", ActionController = "Enseignants" })" />
}
else
{
    <div class="gs-table-wrapper gs-table-responsive">
        <table class="gs-table" id="enseignantsTable">
            <thead>
                <tr>
                    <th><partial name="_SortLink" model="@(new SortLinkViewModel { Text = "Nom", SortKey = "Nom", CurrentSort = ViewBag.SortBy, CurrentDir = ViewBag.SortDir })" /></th>
                    <th><partial name="_SortLink" model="@(new SortLinkViewModel { Text = "Prénom", SortKey = "Prenom", CurrentSort = ViewBag.SortBy, CurrentDir = ViewBag.SortDir })" /></th>
                    <th><partial name="_SortLink" model="@(new SortLinkViewModel { Text = "Email", SortKey = "Email", CurrentSort = ViewBag.SortBy, CurrentDir = ViewBag.SortDir })" /></th>
                    <th><partial name="_SortLink" model="@(new SortLinkViewModel { Text = "Spécialité", SortKey = "Specialite", CurrentSort = ViewBag.SortBy, CurrentDir = ViewBag.SortDir })" /></th>
                    <th class="col-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr data-row>
                        <td>@item.Nom</td>
                        <td>@item.Prenom</td>
                        <td>@item.Email</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Specialite))
                            {
                                <span class="badge-soft info">@item.Specialite</span>
                            }
                        </td>
                        <td class="col-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="Détails" aria-label="Détails de @item.Nom">@IconHelper.Render("eye")</a>
                            <button type="button" class="btn-icon" title="Modifier" aria-label="Modifier @item.Nom" data-bs-toggle="modal" data-bs-target="#editEnseignantModal" data-edit="@System.Text.Json.JsonSerializer.Serialize(new { item.Id, item.Nom, item.Prenom, item.Email, item.Specialite, item.DepartementId, url = Url.Action("Edit", new { id = item.Id }) })">
                                @IconHelper.Render("pencil")
                            </button>
                            <button type="button" class="btn-icon" title="Supprimer" aria-label="Supprimer @item.Nom" data-bs-toggle="modal" data-bs-target="#confirmDeleteEnseignant" data-id="@item.Id" data-label="@item.Nom @item.Prenom" data-restore="@System.Text.Json.JsonSerializer.Serialize(new { item.Nom, item.Prenom, item.Email, item.Specialite, item.DepartementId })">
                                @IconHelper.Render("trash")
                            </button>
                        </td>
                    </tr>
                }
                <tr data-search-empty style="display:none;">
                    <td colspan="5" style="text-align:center;color:var(--text-secondary);padding:var(--space-5);">Aucun résultat pour cette recherche.</td>
                </tr>
            </tbody>
        </table>
        <partial name="_Pagination" model="Model" />
    </div>
}

<partial name="_ConfirmDeleteModal" model="@(new ConfirmDeleteModalViewModel { Id = "confirmDeleteEnseignant", Title = "Supprimer cet enseignant ?", Message = "Cette action est irréversible.", Controller = "Enseignants" })" />

<div class="modal fade" id="createEnseignantModal" tabindex="-1" aria-labelledby="createEnseignantModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Enseignants" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="createEnseignantModalLabel">Nouvel enseignant</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label">Nom</label>
                        <input type="text" name="Nom" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Prénom</label>
                        <input type="text" name="Prenom" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Spécialité</label>
                        <input type="text" name="Specialite" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Département</label>
                        <select name="DepartementId" class="form-select" asp-items="@(ViewBag.Departements as SelectList)">
                            <option value="">-- Choisir un département --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Créer l'enseignant</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editEnseignantModal" tabindex="-1" aria-labelledby="editEnseignantModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Enseignants" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="editEnseignantModalLabel">Modifier l'enseignant</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" />
                    <div class="form-group">
                        <label class="form-label">Nom</label>
                        <input type="text" name="Nom" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Prénom</label>
                        <input type="text" name="Prenom" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Spécialité</label>
                        <input type="text" name="Specialite" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Département</label>
                        <select name="DepartementId" class="form-select" asp-items="@(ViewBag.Departements as SelectList)">
                            <option value="">-- Choisir un département --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>
