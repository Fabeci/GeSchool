@model CreateEtudiantDto

@{
    ViewData["Title"] = "Créer un étudiant";
    var sexeOptions = new SelectList(new[]
    {
        new { Value = nameof(Sexe.Masculin), Text = "Masculin" },
        new { Value = nameof(Sexe.Feminin), Text = "Féminin" }
    }, "Value", "Text", Model.Sexe?.ToString());
}

<div class="card" style="max-width:640px;">
    <div class="card-body">
        <form asp-controller="Etudiants" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:var(--space-4);"></div>

            <div class="gs-form-section">
                <h2>Informations personnelles</h2>
                <div class="form-group">
                    <label asp-for="Nom" class="form-label"></label>
                    <input asp-for="Nom" class="form-control" />
                    <span asp-validation-for="Nom" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Prenom" class="form-label"></label>
                    <input asp-for="Prenom" class="form-control" />
                    <span asp-validation-for="Prenom" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DateNaissance" class="form-label"></label>
                    <input asp-for="DateNaissance" type="date" class="form-control" />
                    <span asp-validation-for="DateNaissance" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Sexe" class="form-label"></label>
                    <select asp-for="Sexe" class="form-select" asp-items="sexeOptions">
                        <option value="">-- Non précisé --</option>
                    </select>
                    <span asp-validation-for="Sexe" class="text-danger"></span>
                </div>
            </div>

            <div class="gs-form-section">
                <h2>Scolarité</h2>
                <div class="form-group">
                    <label asp-for="NumeroEtudiant" class="form-label"></label>
                    <input asp-for="NumeroEtudiant" class="form-control" />
                    <span asp-validation-for="NumeroEtudiant" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DepartementId" class="form-label"></label>
                    <select asp-for="DepartementId" class="form-select" asp-items="@(ViewBag.Departements as SelectList)">
                        <option value="">-- Choisir un département --</option>
                    </select>
                    <span asp-validation-for="DepartementId" class="text-danger"></span>
                </div>
            </div>

            <div style="display:flex;gap:var(--space-2);">
                <button type="submit" class="btn btn-primary">Créer l'étudiant</button>
                <a asp-action="Index" class="btn btn-link">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
