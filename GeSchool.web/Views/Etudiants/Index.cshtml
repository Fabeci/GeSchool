@model PagedList<EtudiantDto>

@{
    ViewData["Title"] = "Étudiants";
    ViewData["Subtitle"] = "Gérer les étudiants inscrits";
}

<div class="gs-page-header">
    <div class="gs-search">
        @IconHelper.Render("search")
        <input type="search" class="form-control" placeholder="Rechercher un étudiant..." data-table-search data-table-target="#etudiantsTable" aria-label="Rechercher un étudiant" />
    </div>
    <button type="button" class="btn btn-outline-secondary" data-csv-export data-csv-target="#etudiantsTable" data-csv-filename="etudiants.csv">
        @IconHelper.Render("download")
        Exporter CSV
    </button>
    @if (User.IsInRole("Administrateur"))
    {
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createEtudiantModal">
            @IconHelper.Render("plus")
            Nouvel étudiant
        </button>
    }
</div>

@if (Model.TotalCount == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "graduation-cap", Title = "Aucun étudiant", Message = User.IsInRole("Administrateur") ? "Aucun étudiant ne correspond à vos critères." : "Aucun étudiant n'est inscrit à vos cours pour le moment.", ActionText = User.IsInRole("Administrateur") ? "Créer un étudiant" : null, ActionController = User.IsInRole("Administrateur") ? "Etudiants" : null })" />
}
else
{
    <div class="gs-table-wrapper gs-table-responsive">
        <table class="gs-table" id="etudiantsTable">
            <thead>
                <tr>
                    <th><partial name="_SortLink" model="@(new SortLinkViewModel { Text = "Étudiant", SortKey = "Nom", CurrentSort = ViewBag.SortBy, CurrentDir = ViewBag.SortDir })" /></th>
                    <th><partial name="_SortLink" model="@(new SortLinkViewModel { Text = "N° Étudiant", SortKey = "NumeroEtudiant", CurrentSort = ViewBag.SortBy, CurrentDir = ViewBag.SortDir })" /></th>
                    <th><partial name="_SortLink" model="@(new SortLinkViewModel { Text = "Email", SortKey = "Email", CurrentSort = ViewBag.SortBy, CurrentDir = ViewBag.SortDir })" /></th>
                    <th>Date de naissance</th>
                    <th class="col-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var initiale = item.Nom.Length > 0 ? item.Nom[..1].ToUpperInvariant() : "?";
                    <tr data-row>
                        <td>
                            <div style="display:flex;align-items:center;gap:var(--space-3);">
                                <span class="gs-avatar">@initiale</span>
                                <span>@item.Nom @item.Prenom</span>
                            </div>
                        </td>
                        <td>@item.NumeroEtudiant</td>
                        <td>@item.Email</td>
                        <td>@item.DateNaissance.ToString("yyyy-MM-dd")</td>
                        <td class="col-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="Détails" aria-label="Détails de @item.Nom">@IconHelper.Render("eye")</a>
                            @if (User.IsInRole("Administrateur"))
                            {
                                <button type="button" class="btn-icon" title="Modifier" aria-label="Modifier @item.Nom" data-bs-toggle="modal" data-bs-target="#editEtudiantModal" data-edit="@System.Text.Json.JsonSerializer.Serialize(new { item.Id, item.NumeroEtudiant, item.Nom, item.Prenom, item.Email, DateNaissance = item.DateNaissance.ToString("yyyy-MM-dd"), item.DepartementId, url = Url.Action("Edit", new { id = item.Id }) })">
                                    @IconHelper.Render("pencil")
                                </button>
                                <button type="button" class="btn-icon" title="Supprimer" aria-label="Supprimer @item.Nom" data-bs-toggle="modal" data-bs-target="#confirmDeleteEtudiant" data-id="@item.Id" data-label="@item.Nom @item.Prenom" data-restore="@System.Text.Json.JsonSerializer.Serialize(new { item.NumeroEtudiant, item.Nom, item.Prenom, item.Email, DateNaissance = item.DateNaissance.ToString("yyyy-MM-dd"), item.DepartementId })">
                                    @IconHelper.Render("trash")
                                </button>
                            }
                        </td>
                    </tr>
                }
                <tr data-search-empty style="display:none;">
                    <td colspan="5" style="text-align:center;color:var(--text-secondary);padding:var(--space-5);">Aucun résultat pour cette recherche.</td>
                </tr>
            </tbody>
        </table>
        <partial name="_Pagination" model="Model" />
    </div>
}

<partial name="_ConfirmDeleteModal" model="@(new ConfirmDeleteModalViewModel { Id = "confirmDeleteEtudiant", Title = "Supprimer cet étudiant ?", Message = "Cette action est irréversible.", Controller = "Etudiants" })" />

@if (User.IsInRole("Administrateur"))
{
    <div class="modal fade" id="createEtudiantModal" tabindex="-1" aria-labelledby="createEtudiantModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Etudiants" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="createEtudiantModalLabel">Nouvel étudiant</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="form-label">N° Étudiant</label>
                            <input type="text" name="NumeroEtudiant" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Nom</label>
                            <input type="text" name="Nom" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Prénom</label>
                            <input type="text" name="Prenom" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Date de naissance</label>
                            <input type="date" name="DateNaissance" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Département</label>
                            <select name="DepartementId" class="form-select" asp-items="@(ViewBag.Departements as SelectList)">
                                <option value="">-- Choisir un département --</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary">Créer l'étudiant</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editEtudiantModal" tabindex="-1" aria-labelledby="editEtudiantModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Etudiants" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="editEtudiantModalLabel">Modifier l'étudiant</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="Id" />
                        <div class="form-group">
                            <label class="form-label">N° Étudiant</label>
                            <input type="text" name="NumeroEtudiant" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Nom</label>
                            <input type="text" name="Nom" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Prénom</label>
                            <input type="text" name="Prenom" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Date de naissance</label>
                            <input type="date" name="DateNaissance" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Département</label>
                            <select name="DepartementId" class="form-select" asp-items="@(ViewBag.Departements as SelectList)">
                                <option value="">-- Choisir un département --</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
