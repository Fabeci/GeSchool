@model PagedList<InscriptionDto>
@{
    ViewData["Title"] = "Inscriptions";
    ViewData["Subtitle"] = "Gérer les inscriptions aux cours";
    var etudiants = (Dictionary<int, EtudiantDto>)ViewBag.Etudiants;
    var cours = (Dictionary<int, CoursDto>)ViewBag.Cours;
}

<div class="gs-page-header">
    <div class="gs-search">
        @IconHelper.Render("search")
        <input type="search" class="form-control" placeholder="Rechercher..." data-table-search data-table-target="#inscriptionsTable" aria-label="Rechercher une inscription" />
    </div>
    <button type="button" class="btn btn-outline-secondary" data-csv-export data-csv-target="#inscriptionsTable" data-csv-filename="inscriptions.csv">
        @IconHelper.Render("download")
        Exporter CSV
    </button>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createInscriptionModal">
        @IconHelper.Render("plus")
        Nouvelle inscription
    </button>
</div>

@if (Model.TotalCount == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "clipboard-list", Title = "Aucune inscription", Message = "Aucune inscription n'a encore été enregistrée.", ActionText = "Créer une inscription", ActionController = "Inscriptions" })" />
}
else
{
    <div class="gs-table-wrapper gs-table-responsive">
        <table class="gs-table" id="inscriptionsTable">
            <thead>
                <tr>
                    <th>Étudiant</th>
                    <th>Cours</th>
                    <th><partial name="_SortLink" model="@(new SortLinkViewModel { Text = "Date d'inscription", SortKey = "DateInscription", CurrentSort = ViewBag.SortBy, CurrentDir = ViewBag.SortDir })" /></th>
                    <th class="col-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var etudiantLabel = etudiants.TryGetValue(item.EtudiantId, out var e) ? $"{e.NumeroEtudiant} - {e.Nom} {e.Prenom}" : item.EtudiantId.ToString();
                    var coursLabel = cours.TryGetValue(item.CoursId, out var c) ? $"{c.Code} - {c.Intitule}" : item.CoursId.ToString();
                    <tr data-row>
                        <td>@etudiantLabel</td>
                        <td>@coursLabel</td>
                        <td>@item.DateInscription.ToString("yyyy-MM-dd")</td>
                        <td class="col-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="Détails" aria-label="Détails">@IconHelper.Render("eye")</a>
                            <button type="button" class="btn-icon" title="Modifier" aria-label="Modifier" data-bs-toggle="modal" data-bs-target="#editInscriptionModal" data-edit="@System.Text.Json.JsonSerializer.Serialize(new { item.Id, item.EtudiantId, item.CoursId, DateInscription = item.DateInscription.ToString("yyyy-MM-dd"), url = Url.Action("Edit", new { id = item.Id }) })">
                                @IconHelper.Render("pencil")
                            </button>
                            <button type="button" class="btn-icon" title="Supprimer" aria-label="Supprimer" data-bs-toggle="modal" data-bs-target="#confirmDeleteInscription" data-id="@item.Id" data-label="@etudiantLabel — @coursLabel" data-restore="@System.Text.Json.JsonSerializer.Serialize(new { item.EtudiantId, item.CoursId, DateInscription = item.DateInscription.ToString("yyyy-MM-dd") })">
                                @IconHelper.Render("trash")
                            </button>
                        </td>
                    </tr>
                }
                <tr data-search-empty style="display:none;">
                    <td colspan="4" style="text-align:center;color:var(--text-secondary);padding:var(--space-5);">Aucun résultat pour cette recherche.</td>
                </tr>
            </tbody>
        </table>
        <partial name="_Pagination" model="Model" />
    </div>
}

<partial name="_ConfirmDeleteModal" model="@(new ConfirmDeleteModalViewModel { Id = "confirmDeleteInscription", Title = "Supprimer cette inscription ?", Message = "Les notes associées seront également supprimées. Cette action est irréversible.", Controller = "Inscriptions" })" />

<div class="modal fade" id="createInscriptionModal" tabindex="-1" aria-labelledby="createInscriptionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Inscriptions" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="createInscriptionModalLabel">Nouvelle inscription</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label">Étudiant</label>
                        <select name="EtudiantId" class="form-select" asp-items="@(ViewBag.EtudiantOptions as SelectList)">
                            <option value="">-- Choisir un étudiant --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Cours</label>
                        <select name="CoursId" class="form-select" asp-items="@(ViewBag.CoursOptions as SelectList)">
                            <option value="">-- Choisir un cours --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Date d'inscription</label>
                        <input type="date" name="DateInscription" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Créer l'inscription</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editInscriptionModal" tabindex="-1" aria-labelledby="editInscriptionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Inscriptions" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="editInscriptionModalLabel">Modifier l'inscription</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" />
                    <div class="form-group">
                        <label class="form-label">Étudiant</label>
                        <select name="EtudiantId" class="form-select" asp-items="@(ViewBag.EtudiantOptions as SelectList)">
                            <option value="">-- Choisir un étudiant --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Cours</label>
                        <select name="CoursId" class="form-select" asp-items="@(ViewBag.CoursOptions as SelectList)">
                            <option value="">-- Choisir un cours --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Date d'inscription</label>
                        <input type="date" name="DateInscription" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>
