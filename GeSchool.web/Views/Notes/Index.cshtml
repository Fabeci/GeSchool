@model PagedList<NoteDto>
@{
    ViewData["Title"] = "Notes";
    ViewData["Subtitle"] = "Suivre les notes des étudiants";
    var labels = (Dictionary<int, string>)ViewBag.InscriptionLabels;

    string TypeBadgeClass(TypeEvaluation type) => type switch
    {
        TypeEvaluation.Examen => "warning",
        TypeEvaluation.TP => "primary",
        TypeEvaluation.Projet => "neutral",
        _ => "info"
    };
}

<div class="gs-page-header">
    <div class="gs-search">
        @IconHelper.Render("search")
        <input type="search" class="form-control" placeholder="Rechercher..." data-table-search data-table-target="#notesTable" aria-label="Rechercher une note" />
    </div>
    <button type="button" class="btn btn-outline-secondary" data-csv-export data-csv-target="#notesTable" data-csv-filename="notes.csv">
        @IconHelper.Render("download")
        Exporter CSV
    </button>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createNoteModal">
        @IconHelper.Render("plus")
        Nouvelle note
    </button>
</div>

@if (Model.TotalCount == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel { Icon = "file-text", Title = "Aucune note", Message = "Aucune note n'a encore été saisie.", ActionText = "Créer une note", ActionController = "Notes" })" />
}
else
{
    <div class="gs-table-wrapper gs-table-responsive">
        <table class="gs-table" id="notesTable">
            <thead>
                <tr>
                    <th>Inscription</th>
                    <th><partial name="_SortLink" model="@(new SortLinkViewModel { Text = "Valeur", SortKey = "Valeur", CurrentSort = ViewBag.SortBy, CurrentDir = ViewBag.SortDir })" /></th>
                    <th>Type d'évaluation</th>
                    <th><partial name="_SortLink" model="@(new SortLinkViewModel { Text = "Date", SortKey = "DateEvaluation", CurrentSort = ViewBag.SortBy, CurrentDir = ViewBag.SortDir })" /></th>
                    <th class="col-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var label = labels.TryGetValue(item.InscriptionId, out var l) ? l : item.InscriptionId.ToString();
                    <tr data-row>
                        <td>@label</td>
                        <td>
                            <span class="badge-soft @(item.Valeur >= 10 ? "success" : "danger")">@item.Valeur / 20</span>
                        </td>
                        <td><span class="badge-soft @TypeBadgeClass(item.TypeEvaluation)">@item.TypeEvaluation</span></td>
                        <td>@item.DateEvaluation.ToString("yyyy-MM-dd")</td>
                        <td class="col-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="Détails" aria-label="Détails">@IconHelper.Render("eye")</a>
                            <button type="button" class="btn-icon" title="Modifier" aria-label="Modifier" data-bs-toggle="modal" data-bs-target="#editNoteModal" data-edit="@System.Text.Json.JsonSerializer.Serialize(new { item.Id, item.InscriptionId, item.Valeur, TypeEvaluation = (int)item.TypeEvaluation, DateEvaluation = item.DateEvaluation.ToString("yyyy-MM-dd"), url = Url.Action("Edit", new { id = item.Id }) })">
                                @IconHelper.Render("pencil")
                            </button>
                            <button type="button" class="btn-icon" title="Supprimer" aria-label="Supprimer" data-bs-toggle="modal" data-bs-target="#confirmDeleteNote" data-id="@item.Id" data-label="@label" data-restore="@System.Text.Json.JsonSerializer.Serialize(new { item.InscriptionId, item.Valeur, TypeEvaluation = (int)item.TypeEvaluation, DateEvaluation = item.DateEvaluation.ToString("yyyy-MM-dd") })">
                                @IconHelper.Render("trash")
                            </button>
                        </td>
                    </tr>
                }
                <tr data-search-empty style="display:none;">
                    <td colspan="5" style="text-align:center;color:var(--text-secondary);padding:var(--space-5);">Aucun résultat pour cette recherche.</td>
                </tr>
            </tbody>
        </table>
        <partial name="_Pagination" model="Model" />
    </div>
}

<partial name="_ConfirmDeleteModal" model="@(new ConfirmDeleteModalViewModel { Id = "confirmDeleteNote", Title = "Supprimer cette note ?", Message = "Cette action est irréversible.", Controller = "Notes" })" />

<div class="modal fade" id="createNoteModal" tabindex="-1" aria-labelledby="createNoteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Notes" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="createNoteModalLabel">Nouvelle note</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label">Inscription</label>
                        <select name="InscriptionId" class="form-select" asp-items="@(ViewBag.InscriptionOptions as SelectList)">
                            <option value="">-- Choisir une inscription --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Valeur</label>
                        <input type="number" name="Valeur" step="0.01" min="0" max="20" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Type d'évaluation</label>
                        <select name="TypeEvaluation" class="form-select" asp-items="Html.GetEnumSelectList<TypeEvaluation>()"></select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Date d'évaluation</label>
                        <input type="date" name="DateEvaluation" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Créer la note</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editNoteModal" tabindex="-1" aria-labelledby="editNoteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Notes" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="editNoteModalLabel">Modifier la note</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" />
                    <div class="form-group">
                        <label class="form-label">Inscription</label>
                        <select name="InscriptionId" class="form-select" asp-items="@(ViewBag.InscriptionOptions as SelectList)">
                            <option value="">-- Choisir une inscription --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Valeur</label>
                        <input type="number" name="Valeur" step="0.01" min="0" max="20" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Type d'évaluation</label>
                        <select name="TypeEvaluation" class="form-select" asp-items="Html.GetEnumSelectList<TypeEvaluation>()"></select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Date d'évaluation</label>
                        <input type="date" name="DateEvaluation" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>
