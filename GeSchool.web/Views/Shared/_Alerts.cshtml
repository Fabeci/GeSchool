@{
    var toasts = new (string Type, string Icon, string? Message, string Role)[]
    {
        ("success", "check-circle", TempData["Success"] as string, "status"),
        ("danger", "x-circle", TempData["Error"] as string, "alert"),
        ("warning", "alert-triangle", TempData["Warning"] as string, "alert"),
        ("info", "info", TempData["Info"] as string, "status"),
    };
}
<div class="gs-toast-container" id="gsToastContainer" aria-live="polite">
    @foreach (var toast in toasts)
    {
        if (toast.Message is not null)
        {
            <div class="gs-toast @toast.Type" role="@toast.Role" data-toast data-toast-type="@toast.Type">
                <span class="gs-toast-icon @toast.Type">@IconHelper.Render(toast.Icon)</span>
                <div class="gs-toast-body">
                    <span>@toast.Message</span>
                    <div class="gs-toast-actions" data-toast-actions></div>
                </div>
                <button type="button" class="gs-toast-close" data-toast-close aria-label="Fermer">
                    @IconHelper.Render("x")
                </button>
            </div>
        }
    }
</div>
