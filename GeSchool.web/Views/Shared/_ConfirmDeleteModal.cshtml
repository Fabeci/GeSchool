@model ConfirmDeleteModalViewModel

<div class="modal fade" id="@Model.Id" tabindex="-1" aria-labelledby="@(Model.Id)Label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="@Model.Controller" asp-action="@Model.Action" method="post" data-delete-form>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="@(Model.Id)Label">@Model.Title</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p>@Model.Message</p>
                    <p class="fw-semibold" data-modal-label></p>
                    <input type="hidden" name="@Model.IdFieldName" data-modal-id-input value="" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">
                        @IconHelper.Render("trash")
                        Supprimer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
