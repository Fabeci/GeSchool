@model EmptyStateViewModel

<div class="gs-empty-state">
    <div class="icon-wrap">
        @IconHelper.Render(Model.Icon)
    </div>
    <h3>@Model.Title</h3>
    <p>@Model.Message</p>
    @if (!string.IsNullOrEmpty(Model.ActionText) && !string.IsNullOrEmpty(Model.ActionController))
    {
        <a asp-controller="@Model.ActionController" asp-action="@Model.ActionAction" class="btn btn-primary">
            @IconHelper.Render("plus")
            @Model.ActionText
        </a>
    }
</div>
