<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GeSchool</title>
    <script>
        (function () {
            var stored = localStorage.getItem('gs-theme');
            if (stored === 'light' || stored === 'dark') {
                document.documentElement.setAttribute('data-theme', stored);
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GeSchool.web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="gs-app-shell">
        <partial name="_Sidebar" />
        <div class="gs-app-main">
            <partial name="_Topbar" />
            <main class="gs-content">
                <partial name="_Alerts" />
                <partial name="_Breadcrumb" />
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="gs-sidebar-backdrop" id="gsSidebarBackdrop"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
